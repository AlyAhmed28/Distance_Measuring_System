#include"lcd.h"
#include"ultrasonic.h"
#include<avr/interrupt.h>

int main()
{

	uint16 read=0;
	Ultrasonic_init();

	LCD_init();

	LCD_displayString("distance = ");

	Ultrasonic_Trigger();

	read=Ultrasonic_readDistance();

	LCD_moveCursor(0, 12);
	LCD_integerToString(read);

	while(1)
	{

	}

}
